    "checks": "node scripts/viewer_checks.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "playwright": "1.58.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
