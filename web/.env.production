# Release build only (npm run build / npm run deploy). The dev server keeps every feature on.
# v1: summer only, time of day, water, clouds, landmarks, streets, search, share, notes. Turn others on one by one.
VITE_FEATURES_OFF=seasons,christmas,snow,traffic,emergency,signals,transit,birds,tiltShift,surprise,statues,liftCabin,eventRides,events,newYear,nationalDay,schueberfouer,octave,emaischen,marathon,halloween,buergbrennen,musicStages,fireworks,weather,fog,planes,perfHud
# Notes from visitors (public values; on in v1 as the comments feature)
VITE_FEEDBACK_API=https://api.isometric.lu
VITE_TURNSTILE_SITEKEY=0x4AAAAAAF3eQAHBVFnCFPz2
# Visitor statistics (public IDs): Cloudflare Web Analytics site token, always on (cookieless);
# Google Analytics, loaded only after the visitor allows it (see src/analytics.ts).
VITE_CF_BEACON=1c4799a601fd4acea883a978dd37783c
VITE_GA_ID=G-9NV85SLRE8
# Error reports (public DSN; source maps upload only with SENTRY_AUTH_TOKEN set locally, see vite.config.ts)
VITE_SENTRY_DSN=https://59d6083b6e0851dd82d45779700f9885@o4511237586485248.ingest.de.sentry.io/4512396537364560
